+# ---------------------------------------------------------------- draft amendment 5: mesh events and the controller
+
+SMOKE_1255='benchmarks/results/2026-10-14-ball-track/20261014T051036.115106Z_smoke_C1_n200'
+
+def _forced_merge_step(ball_fixed,merge,dt,events=None):
+    """One evolve step of the Ball row-0 toy (fixed-mass base, mapped metric) with merge threshold `merge`:
+    0.7 merges one pair of Lagrangian envelope cells, 0.6 none. events None: the registered rule (no key)."""
+    s,_,c=ball_fixed;z=zero_time(s);before=stepcontrol.observables(z,EOS,'face')
+    cc=copy.deepcopy(c);cc['quasistatic']['merge']=merge;cc['stepcontrol']=dict(metric='mapped')
+    if events is not None:cc['stepcontrol']['events']=events
+    new,d=quasistatic.bondi_step(z,dt*YEAR,EOS,OPACITY,cc,mode='evolve')
+    return d,stepcontrol.metrics(before,stepcontrol.observables(new,EOS,'face'),d,stepcontrol.settings(cc))
+
+def test_registered_rule_counts_a_mesh_event_jump_at_every_dt(ball_fixed):
+    """The defect behind draft amendment 5, on the analytic toy (passes before and after the fix): a merge
+    in the Lagrangian envelope changes the discrete solution by the change of its truncation error,
+    whatever dt is, and the registered rule counts it as a timestep error. delta_actual of the step with
+    the merge stays at 3.5e-4 to 7.2e-4 from dt = 1e-6 yr to 1 yr; without the merge it is 1.5e-7 at
+    1e-6 yr. Halving dt therefore never removes it (smoke run 20261014T051036.115106Z_smoke_C1_n200:
+    the jump was 1.5-1.9%, above 2 x delta_target, so every retry was rejected)."""
+    jump=[]
+    for dt in (1e-6,1e-2,1.):
+        d,m=_forced_merge_step(ball_fixed,.7,dt);dn,mn=_forced_merge_step(ball_fixed,.6,dt)
+        assert d['merges']==1 and dn['merges']==dn['splits']==0
+        assert m['delta_actual']>=3e-4 and d['remesh_effect_solved']
+        jump.append(m['delta_actual'])
+    assert mn['delta_actual']<m['delta_actual'] and min(jump)>=.4*max(jump)
+    d,m=_forced_merge_step(ball_fixed,.6,1e-6);assert m['delta_actual']<=1e-6
+
+def test_mesh_event_jump_is_not_a_timestep_error(ball_fixed):
+    """Draft amendment 5 (fails before: stepcontrol has no 'events' setting and the step no event-free
+    record). With stepcontrol events='counterfactual' every component of delta_actual on a step with a
+    split or merge is measured on the same step solved on the pre-event mesh: it equals delta_actual of
+    the same step without the merge and vanishes with dt, while the event's own jump stays in the step
+    diagnostics. Without an event the amended rule is the registered one, bitwise."""
+    free=[]
+    for dt in (1e-6,1e-2,1.):
+        dm,mm=_forced_merge_step(ball_fixed,.7,dt,'measured');dc,mc=_forced_merge_step(ball_fixed,.7,dt,'counterfactual')
+        dn,mn=_forced_merge_step(ball_fixed,.6,dt,'counterfactual');_,mr=_forced_merge_step(ball_fixed,.7,dt)
+        assert dm['merges']==dc['merges']==1 and dn['merges']==dn['splits']==0 and dn['event_free'] is None
+        assert mm==mr and mm['delta_actual']>=3e-4  # 'measured' is the registered rule
+        assert dc['mapped_max_dlnT']==dm['mapped_max_dlnT']>=3e-4  # the jump is still reported
+        for k,v in mn.items():assert abs(mc[k]-v)<=1e-12*max(abs(v),1e-300),(dt,k)
+        assert abs(dc['event_free_mapped_max_dlnT']-dn['mapped_max_dlnT'])<=1e-12*dn['mapped_max_dlnT']
+        free.append(mc['delta_actual'])
+    assert free[0]<=1e-6 and free[0]<=1e-3*mm['delta_actual']
+    _,m6=_forced_merge_step(ball_fixed,.6,1.,'measured')
+    assert m6==mn
+
+def test_smoke_step_1255_merge_is_measured_on_the_pre_event_mesh():
+    """Opt-in (QSTARS_MESA_LIBRARY of an ABI 7 build, MESA_DIR) on the preserved failing smoke run: from its
+    last accepted state (step 1255, M_BH = 46.0 Msun) every step merges two outer cells (0.05 Msun below the
+    surface, T = 7400 K, in the hydrogen opacity peak) and the temperature of the cell below moves by
+    1.9% whatever dt is; the measured rule rejects every dt (the run's 8 rejections from 172 yr down to
+    1.34 yr). On the pre-event mesh the same step changes the profile by 2.4e-5 at 1 yr and 3.6e-3 at the
+    controller's 172 yr: events='counterfactual' accepts it."""
+    import os
+    from pathlib import Path
+    library,directory=os.environ.get('QSTARS_MESA_LIBRARY'),os.environ.get('MESA_DIR')
+    if not library or not directory:pytest.skip('Set QSTARS_MESA_LIBRARY and MESA_DIR for compiled MESA tests')
+    run=Path(__file__).resolve().parents[1]/SMOKE_1255
+    if not (run/'checkpoint.npz').is_file():pytest.skip('preserved smoke run not present (results are not part of a source checkout)')
+    from qstars.eos import Composition
+    from qstars.mesa_microphysics import MesaMicrophysics
+    state,config=quasistatic.load_checkpoint(run/'checkpoint.npz')
+    assert state.steps==1255 and len(state.dm)==174
+    eos=MesaMicrophysics(Composition(**config['composition']),library,directory)
+    opacity=quasistatic.opacity_tables(config,eos,eos.opacity)
+    before=stepcontrol.observables(state,eos,'face')
+    out={}
+    for events in ('measured','counterfactual'):
+        c=copy.deepcopy(config);c['stepcontrol']['events']=events;S=stepcontrol.settings(c)
+        for dt in (1.,172.1438701239381):
+            new,d=quasistatic.bondi_step(state,dt*YEAR,eos,opacity,c,mode='evolve')
+            m=stepcontrol.metrics(before,stepcontrol.observables(new,eos,'face'),d,S)
+            assert d['merges']==1 and d['splits']==0 and len(new.dm)==173
+            out[events,dt]=(m,d)
+    for dt in (1.,172.1438701239381):
+        m,d=out['measured',dt]
+        assert stepcontrol.rejected(m['delta_actual'],S) and m['delta_actual']==m['profile_dlnT']>=.015
+        m,d=out['counterfactual',dt]
+        assert not stepcontrol.rejected(m['delta_actual'],S) and d['mapped_max_dlnT']>=.015
+    assert out['counterfactual',1.][0]['delta_actual']<=1e-4
+    assert out['counterfactual',172.1438701239381][0]['delta_actual']<=stepcontrol.settings(config)['delta_target']
