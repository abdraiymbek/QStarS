        "patch": "@@ -8,16 +8,16 @@ jobs:\n     name: Build SDist\n     runs-on: ubuntu-latest\n     steps:\n-    - uses: actions/checkout@v4\n+    - uses: actions/checkout@v7\n \n-    - uses: actions/setup-python@v5\n+    - uses: actions/setup-python@v7\n       with:\n         python-version: '3.11'\n \n-    - run: python -m pip install pep517\n-    - run: python -m pep517.build --source .\n+    - run: python -m pip install build\n+    - run: python -m build --sdist\n \n-    - uses: actions/upload-artifact@v4\n+    - uses: actions/upload-artifact@v7\n       with:\n         name: artifact-sdist\n         path: dist/*.tar.gz\n@@ -30,24 +30,23 @@ jobs:\n         os: [ubuntu-22.04, windows-latest, macos-latest]\n \n     steps:\n-    - uses: actions/checkout@v4\n+    - uses: actions/checkout@v7\n \n-    - uses: actions/setup-python@v5\n+    - uses: pypa/cibuildwheel@v4.2.1\n       with:\n-        python-version: '3.11'\n-\n-    - run: python -m pip install cibuildwheel\n-\n-    - run: python -m cibuildwheel --output-dir wheelhouse\n+        output-dir: wheelhouse\n       env:\n         CIBW_BUILD: cp310-* cp311-* cp312-* cp313-* cp314-*\n         CIBW_SKIP: \"*-musllinux_*\"\n         CIBW_ARCHS: auto64\n         CIBW_ENVIRONMENT: 'LW_CI_BUILD=true'\n         CIBW_BUILD_VERBOSITY: 1\n         CIBW_ARCHS_MACOS: x86_64 universal2\n+        # NOTE: libenkiTS.pyd ships alongside LwCompiled in the package; delvewheel\n+        # (now the cibuildwheel default) can't resolve it, and it isn't needed.\n+        CIBW_REPAIR_WHEEL_COMMAND_WINDOWS: \"\"\n \n-    - uses: actions/upload-artifact@v4\n+    - uses: actions/upload-artifact@v7\n       with:\n         name: artifact-${{ matrix.os }}\n         path: wheelhouse/*.whl"
