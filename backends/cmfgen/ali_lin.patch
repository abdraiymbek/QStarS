 	CALL TUNE(1,'UP_TX')
+!
+! QSTARS QS_ALI_LIN: local formal-solution ALI response (approximate Jacobian; drives Newton only).
+! The moment recursion is not used. For each depth i,
+!   sig_i = THETA(i)*CHI(i)   (coherent-scattering opacity; THETA=ES_COH_VEC, 0 if incoherent)
+!   Psi_i = L*_i/(1-sig_i*L*_i)  with L*_i=QS_LSTAR(i) = dJ_i/d(total emissivity)
+!                            from the last formal solve at this frequency
+!   S_i   = (ETA(i)+sig_i*J_i)/CHI(i)   (total source function; J_i is the formal JNU)
+! giving the diagonal response TX(i,i,2)=dJ/dETA=Psi_i, TX(i,i,1)=dJ/dCHI=-Psi_i*S_i.
+! QS_LIN_FAC (VADAT, default 1) rescales Psi for diagnostics only; it scales both entries.
+!
+	IF(QS_ALI_LIN)THEN
+	  TX(:,:,:)=0.0_LDP
+	  TVX(:,:,:)=0.0_LDP
+	  TX_DIF_d_T(:)=0.0_LDP
+	  TX_DIF_d_dTdR(:)=0.0_LDP
+	  TVX_DIF_d_T(:)=0.0_LDP
+	  TVX_DIF_d_dTdR(:)=0.0_LDP
+	  IF(.NOT. ALLOCATED(QS_LSTAR) .OR. SIZE(QS_LSTAR) .LT. ND)THEN
+	    OPEN(NEWUNIT=QSTARS_LU,FILE='QSTARS_ALI_LIN_FAILURE',STATUS='UNKNOWN',POSITION='APPEND')
+	    WRITE(QSTARS_LU,*)'QS_LSTAR unavailable',FREQ,dLOG_NU
+	    CLOSE(QSTARS_LU)
+	    WRITE(LUER,*)'Error in VAR_JREL_V5: QS_ALI_LIN set but QS_LSTAR not computed'
+	    STOP
+	  END IF
+	  IF(INIT .OR. .NOT. ALLOCATED(QS_QMAX) .OR. SIZE(QS_QMAX) .NE. ND)THEN
+	    IF(ALLOCATED(QS_QMAX))THEN
+	      DEALLOCATE(QS_QMAX,QS_QFREQ,QS_QDEN,QS_QN99,QS_QN999)
+	    END IF
+	    ALLOCATE(QS_QMAX(ND),QS_QFREQ(ND),QS_QDEN(ND),QS_QN99(ND),QS_QN999(ND))
+	    QS_QMAX(:)=0.0_LDP; QS_QFREQ(:)=0.0_LDP; QS_QDEN(:)=0.0_LDP
+	    QS_QN99(:)=0; QS_QN999(:)=0
+	  END IF
+	  DO I=1,ND
+	    QS_SIG=THETA(I)*CHI(I)
+	    QS_DEN=1.0_LDP-QS_SIG*QS_LSTAR(I)
+	    IF(.NOT. (QS_DEN .GT. 0.0_LDP) .OR. .NOT. (ABS(QS_LSTAR(I)) .LE. HUGE(T1)))THEN
+	      OPEN(NEWUNIT=QSTARS_LU,FILE='QSTARS_ALI_LIN_FAILURE',STATUS='UNKNOWN',POSITION='APPEND')
+	      WRITE(QSTARS_LU,*)'FREQ',FREQ,dLOG_NU
+	      WRITE(QSTARS_LU,*)'I QS_LSTAR THETA*CHI 1-sig*L ETA CHI JNU'
+	      DO QSTARS_I=1,ND
+	        WRITE(QSTARS_LU,'(I4,7ES16.7)')QSTARS_I,QS_LSTAR(QSTARS_I),
+	1          THETA(QSTARS_I)*CHI(QSTARS_I),
+	2          1.0_LDP-THETA(QSTARS_I)*CHI(QSTARS_I)*QS_LSTAR(QSTARS_I),
+	3          ETA(QSTARS_I),CHI(QSTARS_I),JNU(QSTARS_I)
+	      END DO
+	      CLOSE(QSTARS_LU)
+	      WRITE(LUER,*)'Error in VAR_JREL_V5: invalid ALI local response (QS_ALI_LIN)'
+	      STOP
+	    END IF
+	    QS_PSI=QS_LIN_FAC*QS_LSTAR(I)/QS_DEN
+	    QS_SRC=(ETA(I)+QS_SIG*JNU(I))/CHI(I)
+	    IF(DO_THIS_TX_MATRIX(1))TX(I,I,1)=-QS_PSI*QS_SRC
+	    IF(DO_THIS_TX_MATRIX(2))TX(I,I,2)=QS_PSI
+! QSTARS diagnostic only: accumulate trapping measure q = Psi*(CHI-sig) per
+! depth over the frequency sweep; written once per iteration to
+! QSTARS_ALI_LIN_Q from CMFGEN_SUB after the 10000 frequency loop.
+	    QS_Q=QS_PSI*(CHI(I)-QS_SIG)
+	    IF(QS_Q .GT. QS_QMAX(I))THEN
+	      QS_QMAX(I)=QS_Q; QS_QFREQ(I)=FREQ; QS_QDEN(I)=QS_DEN
+	    END IF
+	    IF(QS_Q .GT. 0.99_LDP)QS_QN99(I)=QS_QN99(I)+1
+	    IF(QS_Q .GT. 0.999_LDP)QS_QN999(I)=QS_QN999(I)+1
+	  END DO
+	ELSE
 	CALL UP_TX_TVX(TX,TVX,KI,TA,TB,TC,PSIPREV_MOD,
 	1                       VB,VC,HU,HL,HS,RHS_dHdCHI,
 	1                       EPS_A,EPS_B,EPS_PREV_A,EPS_PREV_B,
 	1                       WORKMAT,ND,NM,NM_KI,
 	1                       INIT,DO_THIS_TX_MATRIX)
+	END IF
 	CALL TUNE(2,'UP_TX')
 !
 ! 
