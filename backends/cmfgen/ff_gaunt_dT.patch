+ , 5.49_ldp,4.87_ldp,4.25_ldp,3.61_ldp,2.98_ldp,2.41_ldp,1.89_ldp,1.39_ldp,0.95_ldp,0.59_ldp,0.36_ldp,0.21_ldp &
+ , 5.46_ldp,4.84_ldp,4.22_ldp,3.59_ldp,2.97_ldp,2.41_ldp,1.91_ldp,1.44_ldp,1.00_ldp,0.63_ldp,0.39_ldp,0.24_ldp &
+ , 5.43_ldp,4.80_ldp,4.18_ldp,3.56_ldp,2.95_ldp,2.41_ldp,1.93_ldp,1.49_ldp,1.08_ldp,0.72_ldp,0.46_ldp,0.28_ldp &
+ , 5.40_ldp,4.77_ldp,4.15_ldp,3.54_ldp,2.94_ldp,2.41_ldp,1.95_ldp,1.55_ldp,1.17_ldp,0.86_ldp,0.59_ldp,0.38_ldp &
+ , 5.25_ldp,4.63_ldp,4.02_ldp,3.41_ldp,2.81_ldp,2.32_ldp,1.90_ldp,1.56_ldp,1.30_ldp,1.01_ldp,0.76_ldp,0.53_ldp &
+ , 5.00_ldp,4.40_ldp,3.80_ldp,3.22_ldp,2.65_ldp,2.19_ldp,1.80_ldp,1.51_ldp,1.32_ldp,1.14_ldp,0.97_ldp,0.76_ldp &
+ , 4.69_ldp,4.13_ldp,3.57_ldp,2.97_ldp,2.44_ldp,2.02_ldp,1.68_ldp,1.42_ldp,1.30_ldp,1.18_ldp,1.09_ldp,0.96_ldp &
+ , 4.48_ldp,3.87_ldp,3.27_ldp,2.70_ldp,2.21_ldp,1.84_ldp,1.52_ldp,1.33_ldp,1.20_ldp,1.15_ldp,1.13_ldp,1.08_ldp &
+ , 4.16_ldp,3.52_ldp,2.98_ldp,2.45_ldp,2.01_ldp,1.67_ldp,1.41_ldp,1.25_ldp,1.15_ldp,1.11_ldp,1.10_ldp,1.09_ldp &
+ , 3.85_ldp,3.27_ldp,2.70_ldp,2.20_ldp,1.81_ldp,1.50_ldp,1.30_ldp,1.17_ldp,1.11_ldp,1.08_ldp,1.08_ldp,1.09_ldp/
