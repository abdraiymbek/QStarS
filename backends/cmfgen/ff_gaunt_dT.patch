+
+! Build 34: d(CHI)/dT and d(ETA)/dT of the ion free-free continuum through the Gaunt factor, at the continuum
+! evaluation frequency NU (= CONT_FREQ), for the ions and the variable set of COMP_VAR_OPAC/VAR_OP_V10:
+! every ion with XzV_PRES and N_XzV_PHOT >= 1 and charge Z > 0 (H0, Z = 0, is H-minus free-free, whose
+! DO_H0_FF_VAR already differentiates its table in T); POP_SUM = sum of the populations of ATM(ID+1);
+! counted in VCHI/VETA only when IMP_VAR(EQION) (else VCHI_NOT_IMP), so here only then, or always with VCHI_ALL.
+! GENOPAETA_V10: CHI += CHIFF Z^2/nu^3 ED POP_SUM g/sqrt(T) (1-exp(-h nu/kT)), ETA += CHIFF Z^2 2h/c^2 ED POP_SUM
+! g/sqrt(T) exp(-h nu/kT). VAR_OP_V10 has every term of their T derivative except the one through g:
+!   dCHI/dT += CHIFF Z^2/nu^3 ED POP_SUM (dg/dT)/sqrt(T) (1-exp(-h nu/kT)),  dETA/dT += CHIFF Z^2 2h/c^2 ED
+!   POP_SUM (dg/dT)/sqrt(T) exp(-h nu/kT).
+! FF_RES_GAUNT (free-free resonances, added to g in GENOPAETA_V10 for ION_LEV = 1) is absent from VAR_OP_V10 in
+! every column; it is not added here (count in st_gff_nres; zero for the H/He models).
+subroutine qs_jv_gff_freq(nu)
+use set_kind_module
+use qs_jv_state
+use mod_cmfgen, only: atm,num_ions,t,ed,imp_var
+use phot_data_mod, only: pd
+implicit none
+real(kind=ldp),intent(in)::nu
+real(kind=ldp)::chibf,chiff,hdkt,twohcsq
+common /constants/ chibf,chiff,hdkt,twohcsq
+real(kind=ldp)::g(jv_nd),gref(jv_nd),dgdt(jv_nd),pop_sum(jv_nd),z,tchi1,teta1,emh,al
+integer::id,l,nd,eqion,nion
+nd=jv_nd
+gff_dchi=0;gff_deta=0
+gff_valid=.true.
+st_gff_nfreq=st_gff_nfreq+1
+nion=0
+do id=1,num_ions
+ if(.not.atm(id)%xzv_pres)cycle
+ if(atm(id)%n_xzv_phot<1)cycle
+ z=atm(id)%zxzv
+ if(z==0.0_ldp)cycle
+ eqion=atm(id+1)%eqxzv+(atm(id)%xzv_ion_lev_id(1)-1)
+ if(.not.(jv_vall.or.imp_var(eqion)))cycle
+ nion=nion+1
+ if(pd(id)%num_ff>0.and.atm(id)%xzv_ion_lev_id(1)==1)st_gff_nres=max(st_gff_nres,pd(id)%num_ff)
+ call qs_gff_dt_vec(g,dgdt,nu,t(1:nd),z,nd)
+ call gff_vec(gref,nu,t,z,nd)
+ st_gff_gdiff=max(st_gff_gdiff,maxval(abs(g-gref)))
+ do l=1,nd
+  pop_sum(l)=sum(atm(id+1)%xzv(:,l))
+ enddo
+ tchi1=chiff*z*z/(nu**3)
+ teta1=chiff*z*z*twohcsq
+ do l=1,nd
+  emh=exp(-hdkt*nu/t(l))
+  al=ed(l)*pop_sum(l)*dgdt(l)/sqrt(t(l))
+  gff_dchi(l)=gff_dchi(l)+tchi1*al*(1.0_ldp-emh)
+  gff_deta(l)=gff_deta(l)+teta1*al*emh
+ enddo
+enddo
+st_gff_nion=max(st_gff_nion,nion)
+end subroutine qs_jv_gff_freq
 
