+! Build 35: Gaunt-factor term of DIFFW(NT) for the tangent. Called from the DTDR section of cmfgen_sub.f:
+!   MODE 0 at its start (zero); MODE 1 right after DIFFW is incremented at frequency FL, with that statement's T3
+!   and CHI(ND); MODE 2 after DIFFW is scaled, with the scale SCL = DTDR**2/T1 of that statement.
+! DIFFW(NT) += T3*(VCHI(NT,ND)/CHI(ND) - Planck part), VCHI(NT,ND) from VAR_OP_V10 at CONT_FREQ (g fixed) moved to
+! FL by COMP_VAR_OPAC. The missing part is T3*dCHI_g(FL,ND)/CHI(ND), with the dCHI_g/dETA_g of qs_jv_gff_freq at
+! depth ND (same ions; IMP_VAR(EQION) for dtg_sum, every ion for dtg_sum_all) moved to FL the same way:
+! dCHI(FL) = dCHI(CONT) + dETA(CONT)/(2h/c^2 CONT^3) - dETA(CONT) T4/(2h/c^2 FL^3), T4 = (FL/CONT)^3 exp(-h(FL-CONT)/kT).
+! Reads the state only; writes only qs_jv_state (no native array). Runs in every pass that computes DIFFW.
+subroutine qs_jv_dtdr_gff(mode,fl,cont_freq,t3,chind,scl,nd)
+use set_kind_module
+use qs_jv_state, only: dtg_sum,dtg_sum_all,diffw_gff,diffw_gff_all,dtg_nfreq,dtg_nres
+use mod_cmfgen, only: atm,num_ions,t,ed,imp_var
+use phot_data_mod, only: pd
+implicit none
+integer,intent(in)::mode,nd
+real(kind=ldp),intent(in)::fl,cont_freq,t3,chind,scl
+real(kind=ldp)::chibf,chiff,hdkt,twohcsq
+common /constants/ chibf,chiff,hdkt,twohcsq
+real(kind=ldp),save::cf_last=-1.0_ldp,dc(2)=0,de(2)=0
+real(kind=ldp)::g(1),dgdt(1),z,al,emh,pop_sum,t4,dcf(2)
+integer::id,eqion,m
+select case(mode)
+case(0)
+ dtg_sum=0;dtg_sum_all=0;diffw_gff=0;diffw_gff_all=0;dtg_nfreq=0;dtg_nres=0;cf_last=-1.0_ldp
+case(1)
+ if(cont_freq/=cf_last)then
+  ! dCHI_g, dETA_g at CONT_FREQ, depth ND: (1) ions with IMP_VAR(EQION), (2) every ion
+  dc=0;de=0
+  do id=1,num_ions
+   if(.not.atm(id)%xzv_pres)cycle
+   if(atm(id)%n_xzv_phot<1)cycle
+   z=atm(id)%zxzv
+   if(z==0.0_ldp)cycle
+   eqion=atm(id+1)%eqxzv+(atm(id)%xzv_ion_lev_id(1)-1)
+   if(pd(id)%num_ff>0.and.atm(id)%xzv_ion_lev_id(1)==1)dtg_nres=max(dtg_nres,pd(id)%num_ff)
+   call qs_gff_dt_vec(g,dgdt,cont_freq,t(nd:nd),z,1)
+   pop_sum=sum(atm(id+1)%xzv(:,nd))
+   emh=exp(-hdkt*cont_freq/t(nd))
+   al=ed(nd)*pop_sum*dgdt(1)/sqrt(t(nd))
+   do m=1,2
+    if(m==1.and..not.imp_var(eqion))cycle
+    dc(m)=dc(m)+chiff*z*z/(cont_freq**3)*al*(1.0_ldp-emh)
+    de(m)=de(m)+chiff*z*z*twohcsq*al*emh
+   enddo
+  enddo
+  cf_last=cont_freq
+ endif
+ if(cont_freq/=fl)then
+  t4=(fl/cont_freq)**3*exp(-hdkt*(fl-cont_freq)/t(nd))
+  dcf=dc+de/(twohcsq*cont_freq**3)-de*t4/(twohcsq*fl**3)
+ else
+  dcf=dc
+ endif
+ dtg_sum=dtg_sum+t3*dcf(1)/chind
+ dtg_sum_all=dtg_sum_all+t3*dcf(2)/chind
+ dtg_nfreq=dtg_nfreq+1
+case(2)
+ diffw_gff=dtg_sum*scl
+ diffw_gff_all=dtg_sum_all*scl
+end select
+end subroutine qs_jv_dtdr_gff
