+close(lu)
+luer=error_lu()
+write(luer,'(1X,A,I6,A)')'Error: QSTARS_JV ff_gaunt_dT: ',nres,' free-free resonances; T derivative not implemented'
+flush(luer)
+stop 'QSTARS_JV: free-free resonances with a T direction (see QSTARS_JV_FAILURE)'
+end subroutine qs_jv_gff_fail
