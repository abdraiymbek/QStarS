+	      IF(W .NE. 0_8)C(4)=C(4)+1
+	    END DO
+	  END DO
+	END DO
+	IF(FIRST)THEN
+	  OPEN(NEWUNIT=LU,FILE='QSTARS_ALI_LIN_HASH.bin',STATUS='REPLACE',ACCESS='STREAM',
