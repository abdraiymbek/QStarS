+!
+	SUBROUTINE QS_ALI_LIN_HASH(FREQ_INDX,FL,FIRST,TX,TVX,dJ_LOC,VJ,ND,NM,NUM_BNDS,NT)
+	USE SET_KIND_MODULE
+	IMPLICIT NONE
+	INTEGER FREQ_INDX,ND,NM,NUM_BNDS,NT
+	LOGICAL FIRST
+	REAL(KIND=LDP) FL
+	REAL(KIND=LDP) TX(ND,ND,NM)
+	REAL(KIND=LDP) TVX(ND-1,ND,NM)
+	REAL(KIND=LDP) dJ_LOC(NM,NUM_BNDS,ND)
