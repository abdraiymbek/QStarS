+!
+! QStarS QS_FRM_ALI: moment-ratio state for the linearized response operator
+! (VAR_JREL_V5) when J is the formal solution and MOM_JREL_V9 is not called.
+! Reproduces MOM_JREL_V9's ratio bookkeeping (INIT zeroing, N/H bound,
+! PREV/SAVE rotation, inner-boundary saves) and sets dln(gam r^2 J)/dlnR from
+! the formal J, the value to which MOM_JREL_V9's advection iteration converges.
+!
+	SUBROUTINE QS_FORMAL_MOM_STATE(R,V,FREQ,N_TYPE,DBB,CHI_IB,INNER_BND_METH,INIT,ND)
+	USE SET_KIND_MODULE
+	USE MOD_JREL_V9, ONLY: FREQ_SAVE,IN_NBC_SAVE,IN_NBC_PREV
+	USE MOD_RAY_MOM_STORE
+	IMPLICIT NONE
+	INTEGER ND
+	REAL(KIND=LDP) R(ND),V(ND)
+	REAL(KIND=LDP) FREQ,DBB,CHI_IB
+	CHARACTER(LEN=*) N_TYPE,INNER_BND_METH
+	LOGICAL INIT
+	REAL(KIND=LDP) GRSQJ(ND),DGRSQJ(ND)
+	INTEGER I
+!
+	IF(ND .NE. ND_STORE)THEN
+	  WRITE(6,*)'Error in QS_FORMAL_MOM_STATE: ND differs from formal-solution grid'
+	  STOP
+	END IF
+	CALL GET_MOMS_REL(R,V,FREQ,N_TYPE,ND)
+	IF(INIT)THEN
+	  H_ON_J(1:ND)=0.0_LDP
+	  N_ON_J(1:ND)=0.0_LDP
+	  KMID_ON_J(1:ND)=0.0_LDP
+	  NMID_ON_J(1:ND)=0.0_LDP
+	  H_ON_J_PREV(:)=0.0_LDP
+	  K_ON_J_PREV(:)=0.0_LDP
+	  N_ON_J_PREV(:)=0.0_LDP
+	  NMID_ON_HMID_PREV(:)=0.0_LDP
+	  NMID_ON_J_PREV(:)=0.0_LDP
+	  KMID_ON_J_PREV(:)=0.0_LDP
+	END IF
+	DO I=1,ND
+	  IF(NMID_ON_HMID(I) .GT. 1.0_LDP)NMID_ON_HMID(I)=1.0_LDP
+	END DO
+	IF(FREQ .NE. FREQ_SAVE .AND. .NOT. INIT)THEN
+	  K_ON_J_PREV(:)=K_ON_J_SAVE(:)
+	  NMID_ON_HMID_PREV(:)=NMID_ON_HMID_SAVE(:)
+	  H_ON_J_PREV(:)=H_ON_J_SAVE(:)
+	  N_ON_J_PREV(:)=N_ON_J_SAVE(:)
+	  NMID_ON_J_PREV(:)=NMID_ON_J_SAVE(:)
+	  KMID_ON_J_PREV(:)=KMID_ON_J_SAVE(:)
+	  HBC_PREV=HBC_SAVE
+	  NBC_PREV=NBC_SAVE
+	  IN_HBC_PREV=IN_HBC_SAVE
+	  IN_NBC_PREV=IN_NBC_SAVE
 	END IF
 !
+	IF(INIT)THEN
+	  dlnGRSQJdlnR(1:ND)=0.0_LDP
+	ELSE
+	  GRSQJ(1:ND)=GAM_REL_STORE(1:ND)*R(1:ND)*R(1:ND)*JNU_STORE(1:ND)
+	  CALL DERIVCHI(DGRSQJ,GRSQJ,R,ND,'LINMON')
+	  dlnGRSQJdlnR(1:ND)=R(1:ND)*DGRSQJ(1:ND)/GRSQJ(1:ND)
+	END IF
+!
+	FREQ_SAVE=FREQ
+	K_ON_J_SAVE(:)=K_ON_J(:)
+	NMID_ON_HMID_SAVE(:)=NMID_ON_HMID(:)
+	H_ON_J_SAVE(:)=H_ON_J(:)
+	N_ON_J_SAVE(:)=N_ON_J(:)
+	NMID_ON_J_SAVE(:)=NMID_ON_J(:)
+	KMID_ON_J_SAVE(:)=KMID_ON_J(:)
+	HBC_SAVE=HBC
+	NBC_SAVE=NBC
+	IF(INNER_BND_METH .EQ. 'DIFFUSION')THEN
+	  IN_HBC_SAVE=DBB*R(ND)*R(ND)/3.0_LDP/CHI_IB
+	  IN_NBC_SAVE=DBB*R(ND)*R(ND)/5.0_LDP/CHI_IB
+	ELSE IF(INNER_BND_METH .EQ. 'ZERO_FLUX')THEN
+	  IN_HBC_SAVE=0.0_LDP
+	  IN_NBC_SAVE=0.0_LDP
+	ELSE
+	  WRITE(6,*)'Error in QS_FORMAL_MOM_STATE: inner boundary not supported: ',TRIM(INNER_BND_METH)
+	  STOP
+	END IF
 	RETURN
 	END
