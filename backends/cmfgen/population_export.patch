+! QStarS: output by ion name, not fixed ion index. H0 shifts HI and He.
+	    DO ID=1,NUM_IONS
+	      IF(.NOT. ATM(ID)%XzV_PRES)CYCLE
+	      SELECT CASE(TRIM(ION_ID(ID)))
+	      CASE('H0')
+	        WRITE(LU_POP,'(A)')' H0 populations'
