+        _COLOURINGS[key]=_COLOURINGS.pop(key)
+        return _COLOURINGS[key]
+    rows=p.tocsr()
+    colour=np.full(p.shape[1],-1,dtype=np.int64)
+    for j in range(p.shape[1]):
+        r=p.indices[p.indptr[j]:p.indptr[j+1]]
